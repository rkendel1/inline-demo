# Public base URL of THIS app once deployed (used to build signature + demo links).
# If unset: on Vercel, the project's production domain (VERCEL_PROJECT_PRODUCTION_URL);
# locally, http://localhost:3000. Set it when you use a custom domain.
NEXT_PUBLIC_BASE_URL=https://demos.yourdomain.com

# Simple shared secret to protect the admin dashboard and write APIs.
# Set this in production. If unset, the admin UI is open (fine for local dev only).
ADMIN_TOKEN=change-me

# --- short_url (storage + signature link) ---
# short_url is where everything is stored: demos, the live slot, the managed short link and
# uploaded media live in short_url's own database (no database here). It also hosts the
# signature link: on the first "Make live", short_url generates a random code (e.g.
# 0-2.ca/otter0427), which is remembered and repointed to the live demo on later changes.
# Unset = local .data/ files (dev only; ephemeral on serverless).
# Generate OWNER + PRIVATE_KEY once with: node scripts/shorturl-keygen.mjs
# SHORT_URL_BASE_URL=https://0-2.ca
# SHORT_URL_OWNER=
# SHORT_URL_PRIVATE_KEY=
# SHORT_URL_CODE=        # optional: force a specific code instead of a random one

# --- Media storage ---
# Uploaded videos, preview GIFs and posters are stored most-durable-first:
#   BLOB_READ_WRITE_TOKEN set -> Vercel Blob (best for large media; npm i @vercel/blob)
#   else short_url configured -> short_url's database, proxied via /uploads/<name>
#   else                      -> local filesystem (.data/uploads; dev only)
# BLOB_READ_WRITE_TOKEN=
