# Public base URL of THIS app once deployed (used to build signature + demo links).
# Local dev default is http://localhost:3000 if unset.
NEXT_PUBLIC_BASE_URL=https://demos.yourdomain.com

# Simple shared secret to protect the admin dashboard and write APIs.
# Set this in production. If unset, the admin UI is open (fine for local dev only).
ADMIN_TOKEN=change-me

# --- short_url integration (optional) ---
# Wire the signature link to a managed short_url link (e.g. 0-2.ca/demo). When set, each
# time you make a demo live, inline-demo repoints this short link to that demo's landing
# page, and the signature uses the short link as its href. Generate OWNER + PRIVATE_KEY
# once with: node scripts/shorturl-keygen.mjs
# SHORT_URL_BASE_URL=https://0-2.ca
# SHORT_URL_OWNER=
# SHORT_URL_CODE=demo
# SHORT_URL_PRIVATE_KEY=

# --- Storage (optional) ---
# The app ships with a zero-setup filesystem store (.data/demos.json + public/uploads).
# For production on Vercel, set BLOB_READ_WRITE_TOKEN and the app will use Vercel Blob
# for uploaded video files instead of the local filesystem. See lib/blob.ts.
# BLOB_READ_WRITE_TOKEN=
