# Public base URL of THIS app once deployed (used to build signature + demo links).
# Local dev default is http://localhost:3000 if unset.
NEXT_PUBLIC_BASE_URL=https://demos.yourdomain.com

# Simple shared secret to protect the admin dashboard and write APIs.
# Set this in production. If unset, the admin UI is open (fine for local dev only).
ADMIN_TOKEN=change-me

# --- short_url integration (optional) ---
# Wire the signature link to a managed short_url link. On the first "Make live", short_url
# generates a random code (e.g. 0-2.ca/otter0427) just like any other short_url link; it's
# remembered and repointed to the live demo on later changes. The signature uses that short
# link as its href. Generate OWNER + PRIVATE_KEY once with: node scripts/shorturl-keygen.mjs
# SHORT_URL_BASE_URL=https://0-2.ca
# SHORT_URL_OWNER=
# SHORT_URL_PRIVATE_KEY=
# SHORT_URL_CODE=        # optional: force a specific code instead of a random one

# --- Database (production: makes links durable) ---
# When set, demos, the live slot, and the short link are stored in Postgres via Prisma, so
# nothing is lost on restart or redeploy. When unset, a local .data/demos.json is used
# (fine for dev, ephemeral on serverless). Any Postgres works (Neon, Supabase, RDS, Vercel
# Postgres). After setting it, run: npm run db:deploy
# DATABASE_URL=postgresql://user:password@host:5432/inline_demo

# --- Storage (optional) ---
# The app ships with a zero-setup filesystem store (.data/demos.json + public/uploads).
# For production on Vercel, set BLOB_READ_WRITE_TOKEN and the app will use Vercel Blob
# for uploaded video files instead of the local filesystem. See lib/blob.ts.
# BLOB_READ_WRITE_TOKEN=
